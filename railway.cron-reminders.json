{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "node -e \"fetch('https://recalltrial.app/api/cron/reminders',{method:'POST',headers:{'X-CRON-KEY':process.env.CRON_KEY}}).then(async r=>{console.log('reminders cron status',r.status,await r.text());process.exit(r.ok?0:1)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "cronSchedule": "0 9 * * *",
    "restartPolicyType": "NEVER"
  }
}
